# Salin ke .env lalu isi sesuai lingkungan (php artisan key:generate untuk APP_KEY).
#
# Opsional, tidak diisi di bawah karena sudah punya default:
#   APP_MAINTENANCE_STORE, CACHE_PREFIX     default bawaan Laravel
#   ALUMNI_REGISTRATION_ENABLED=true        false = tutup registrasi akun alumni
#   ALUMNI_TILE_URL                         default tile OpenStreetMap
#                                           (https://operations.osmfoundation.org/policies/tiles/)
#   ALUMNI_TILE_DARK_URL                    default sama dengan ALUMNI_TILE_URL
#   ALUMNI_TILE_ATTRIBUTION                 default atribusi OpenStreetMap
#   Untuk trafik besar, ganti tile ke penyedia lain, contoh MapTiler:
#     ALUMNI_TILE_URL="https://api.maptiler.com/maps/streets-v4/{z}/{x}/{y}.png?key=YOUR_KEY"
#     ALUMNI_TILE_DARK_URL="https://api.maptiler.com/maps/dataviz-dark/{z}/{x}/{y}.png?key=YOUR_KEY"
#     ALUMNI_TILE_ATTRIBUTION="<a href='https://www.maptiler.com/copyright/'>&copy; MapTiler</a> <a href='https://www.openstreetmap.org/copyright'>&copy; OpenStreetMap contributors</a>"
#   Redis, Memcached, dan S3 (REDIS_*, MEMCACHED_HOST, AWS_*) tidak dipakai; aplikasi
#   memakai driver database dan disk lokal. Tambahkan hanya jika driver diganti.

APP_NAME="PTQ Ma'unah Sari"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=maunahsari_laravel
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false

FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"

ALUMNI_CONTACT_NAME="Pengurus Alumni Maunahsari"
ALUMNI_CONTACT_EMAIL=
ALUMNI_CONTACT_WHATSAPP=
ALUMNI_CONTACT_DAILY_LIMIT=10
